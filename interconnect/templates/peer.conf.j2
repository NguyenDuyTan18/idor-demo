[Interface]
Address = {{ idor_overlay_ip }}/32
PrivateKey = {{ idor_wg_private.content | b64decode | trim }}

[Peer]
PublicKey = {{ hostvars[groups['lab_hub'][0]].idor_wg_public.stdout | trim }}
Endpoint = {{ idor_hub_endpoint }}
# Route only the shared experiment subnet, never private or management networks.
AllowedIPs = {{ idor_overlay_cidr }}
PersistentKeepalive = 25
